# Public app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server REST fallback. Use service role only server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI. If empty, the app uses deterministic local parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini

# Optional payments. Checkout route currently returns demo checkout if not configured.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
MERCADO_PAGO_ACCESS_TOKEN=

# Internal controls
MIH_DEMO_MODE=true
